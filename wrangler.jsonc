{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tpr-coming-soon",
  "account_id": "a1c109f50daeb56ab55f1fff1643ff61",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/coming-soon", "/coming-soon/"]
  },
  "vars": {
    "NEWSLETTER_ALLOWED_ORIGINS": "https://thepeoplesroom.it,https://www.thepeoplesroom.it,https://mircoaurelio.github.io,https://tpr-coming-soon.tpr-coming-soon.workers.dev"
  },
  "ratelimits": [{
    "name": "NEWSLETTER_RATE_LIMITER",
    "namespace_id": "2026092801",
    "simple": { "limit": 30, "period": 60 }
  }],
  "observability": { "enabled": false }
}
